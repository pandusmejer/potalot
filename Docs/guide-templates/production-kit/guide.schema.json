{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PotAlot guide",
  "description": "Kontrakt for en genereret guide. AI'en returnerer JSON der matcher dette; guides:build laver det om til content/guides/<slug>.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "guideLevel", "summary", "sections"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case, ae/oe/aa, ingen accenter. Art: 'tomat'. Sort: 'tomat-san-marzano'. Teknik: 'knibning-af-tomater'."
    },
    "guideLevel": { "enum": ["species", "variety", "technique"] },
    "parentSlug": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kun sortsguides: slug på artsguiden sorten hører under."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Kun teknikguides: H1-titlen, fx 'Sådan kniber du tomater'. Art/sort: udelad (titel afledes af plantName/variety)."
    },
    "plantName": {
      "type": "string",
      "minLength": 1,
      "description": "Art/sort: artens navn, fx 'Tomat'. Teknik: udelad."
    },
    "variety": {
      "type": ["string", "null"],
      "description": "Kun sortsguides. Art/teknik: null eller udeladt."
    },
    "appliesTo": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "description": "Kun teknikguides (valgfri): slugs på de arter/sorter teknikken hører til, fx ['tomat']. Bruges til :::guide-kobling og fremtidig farvetone."
    },
    "latinName": { "type": ["string", "null"] },
    "primaryCategoryId": {
      "enum": ["fro", "loeg", "knolde", "buske", "traeer", "stauder"],
      "description": "Art/sort: påkrævet. Teknik: udelad (teknikguider har ingen plantekategori)."
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "1-2 sætninger. Vises på kort — hold den kort."
    },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "quickFacts": {
      "type": "object",
      "description": "Strukturerede fakta (kun art/sort). AI'en må KUN udfylde det, den har fra inputarket — ikke opfinde tal. Teknikguider har ingen quickFacts.",
      "additionalProperties": false,
      "properties": {
        "preCultivation": { "type": "boolean" },
        "sowingMonths": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
        "directSowingMonths": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
        "plantingOutMonths": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
        "harvestMonths": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
        "light": { "enum": ["full_sun", "partial_shade", "shade"] },
        "water": { "enum": ["low", "regular", "high"] },
        "soil": { "type": "string" },
        "germinationTemperature": { "type": "string" },
        "germinationDays": { "type": "string" },
        "plantSpacing": { "type": "string" },
        "rowSpacing": { "type": "string" },
        "sowingDepthMm": { "type": "integer" },
        "frostSensitive": { "type": "boolean" },
        "minimumTemperature": { "type": "string" },
        "growthType": { "type": "string" },
        "height": { "type": "string" },
        "maturityDays": { "type": "string" },
        "primaryUse": { "type": "string" }
      }
    },
    "calendarRules": { "type": "array", "description": "Som regel tom []; kalenderregler sættes separat." },
    "sourceLinks": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "sections": {
      "type": "array",
      "minItems": 1,
      "description": "Prosa-sektioner i rækkefølge. heading bliver en ## overskrift, content er markdown. Teknikguider: hver sektion er typisk ét kort, imperativt trin.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "content"],
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["guideLevel"], "properties": { "guideLevel": { "const": "species" } } },
      "then": { "required": ["plantName", "primaryCategoryId"] }
    },
    {
      "if": { "required": ["guideLevel"], "properties": { "guideLevel": { "const": "variety" } } },
      "then": { "required": ["plantName", "primaryCategoryId", "parentSlug", "variety"] }
    },
    {
      "if": { "required": ["guideLevel"], "properties": { "guideLevel": { "const": "technique" } } },
      "then": { "required": ["title"] }
    }
  ]
}
