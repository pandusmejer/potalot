{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Potalot guide batch manifest",
  "description": "Ledsager en batch-ZIP. Beskriver hvilke guides der leveres, så Claude kan validere og importere i rigtig rækkefølge (art før sort).",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch", "contractVersion", "guides"],
  "properties": {
    "batch": { "type": "string", "description": "Batch-navn/nummer, fx 'batch-3'." },
    "contractVersion": { "type": "string", "description": "Kittet der er produceret efter, fx 'guide-contract-v1'." },
    "generatedAt": { "type": "string", "description": "ISO-dato for leverancen." },
    "guides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "guideType", "filename"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "guideType": { "enum": ["species", "variety"] },
          "parentSlug": { "type": ["string", "null"], "description": "Kun variety: art-slug." },
          "filename": { "type": "string", "description": "Filnavn i ZIP'en, fx 'salat.json'. Bør matche <slug>.json." },
          "status": { "enum": ["new", "update"], "description": "new = ny slug; update = ændrer en eksisterende guide (kræver eksplicit --update)." },
          "sources": { "type": "array", "items": { "type": "string", "format": "uri" }, "description": "Kilder brugt til denne guide." }
        }
      }
    }
  }
}
