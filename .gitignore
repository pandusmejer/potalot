# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local
.env.local
.env.local.save

# secrets
API keys/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# Forvandlinger asset-reserve (afviste/kandidat-fotos — kun lokalt)
public/assets/forvandlinger/**/_reserve/

# Midlertidig foto-indbakke — Claude henter herfra, committes aldrig
_foto-indbakke/

# Midlertidig guide-indbakke — intake henter herfra, committes aldrig
_guide-indbakke/*
!_guide-indbakke/LÆS-MIG.txt

# Arkiv for foto-originaler (høj-opløst master) — committes aldrig
_foto-arkiv/

# Ephemere guide-produktions-artefakter (regenereres af `npm run guides:build`) — committes aldrig
content/guide-production/built/*
content/guide-production/generated/*
!content/guide-production/built/.gitkeep
!content/guide-production/generated/.gitkeep
